# Run python3 tools/setup.py to generate a private .env. No values below are credentials.
APP_NAME=SMS Bridge
PUBLIC_ORIGIN=https://sms.example.com
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD_HASH=
DEVICE_TOKEN=
# web | both | telegram (telegram disables the web inbox)
DELIVERY_MODE=web
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only acknowledged deliveries in telegram-only mode are pruned. Pending messages stay queued.
TELEGRAM_RETENTION_DAYS=7
# Set only for loopback development. Production requires HTTPS.
LOCAL_HTTP=0
